{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "apavliukov/laravel-authorization": "^1.0.1",
        "blade-ui-kit/blade-heroicons": "^2.5",
        "blade-ui-kit/blade-icons": "^1.7",
        "gehrisandro/tailwind-merge-laravel": "^1.2",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.30",
        "laravel/tinker": "^3.0.2",
        "livewire/flux": "^2.4",
        "opcodesio/log-viewer": "^3.14",
        "sentry/sentry-laravel": "^4.15",
        "spatie/laravel-permission": "^8.0"
    },
    "require-dev": {
        "apavliukov/laravel-devtools": "^0.1.1",
        "barryvdh/laravel-ide-helper": "^3.5",
        "brianium/paratest": "^7.22",
        "dg/bypass-finals": "^1.9",
        "driftingly/rector-laravel": "^2.0",
        "fakerphp/faker": "^1.23",
        "fruitcake/laravel-debugbar": "^4.2",
        "jasonmccreary/laravel-test-assertions": "^2.6",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.4.5",
        "laravel/pail": "^1.1",
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "laravel/telescope": "^5.4",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.0",
        "roave/security-advisories": "dev-latest",
        "xammie/mailbook": "^1.9"
    },
    "autoload": {
        "files": [
            "app/Helpers/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan livewire:publish --assets --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "ide-helper": [
            "@php artisan clear-compiled",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta",
            "@php artisan ide-helper:models --write-mixin"
        ],
        "pint": [
            "Composer\\Config::disableProcessTimeout",
            "@php ./vendor/bin/pint --parallel"
        ],
        "rector": [
            "Composer\\Config::disableProcessTimeout",
            "@php ./vendor/bin/rector process --clear-cache"
        ],
        "refactor": [
            "Composer\\Config::disableProcessTimeout",
            "@composer rector",
            "@composer pint"
        ],
        "clean-code": [
            "Composer\\Config::disableProcessTimeout",
            "@composer refactor",
            "@composer analyse",
            "@composer ide-helper"
        ],
        "analyse": [
            "Composer\\Config::disableProcessTimeout",
            "@php ./vendor/bin/phpstan analyse"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test --compact"
        ],
        "test:parallel": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test --parallel --processes=6"
        ]
    },
    "scripts-descriptions": {
        "dev": "Start the local dev stack (server, queue, logs, vite)",
        "ide-helper": "Regenerate IDE helper files and model mixins",
        "pint": "Apply Pint to PHP and Blade (append -- --dirty to scope it)",
        "rector": "Apply Rector rules (append -- --dry-run to preview)",
        "refactor": "rector + pint",
        "analyse": "Run PHPStan static analysis",
        "clean-code": "refactor + analyse + ide-helper",
        "test": "Run the test suite (append -- --filter=Foo to scope it)",
        "test:parallel": "Run the test suite across 6 processes"
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
